---
// A coach's clip on YouTube, set to start at the moment that shows the
// technique. Until it's tapped it's only a picture, so the page stays quick and
// nothing loads from YouTube. The player comes from youtube-nocookie.com, which
// sets no cookies until the video plays.
interface Props {
  youtube: string;
  start: number;
  end?: number | undefined;
  title: string;
  channel: string;
}
const { youtube, start, end, title, channel } = Astro.props;
const at = (s: number) => `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
const params = new URLSearchParams({ start: String(start), autoplay: '1', rel: '0', playsinline: '1' });
if (end) params.set('end', String(end));
---

<figure class="clip">
  <button
    type="button"
    class="frame"
    data-src={`https://www.youtube-nocookie.com/embed/${youtube}?${params}`}
    data-title={title}
    aria-label={`Play "${title}" from ${at(start)}. It opens YouTube's player here.`}
  >
    <img src={`https://i.ytimg.com/vi/${youtube}/hqdefault.jpg`} alt="" loading="lazy" decoding="async" width="480" height="360" />
    <span class="play" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="30" height="30"><path d="M8 5v14l11-7z" fill="currentColor"></path></svg>
    </span>
    <span class="from" aria-hidden="true">from {at(start)}</span>
  </button>
  <figcaption>
    <strong>{title}</strong>
    <span>
      {channel} · <a href={`https://www.youtube.com/watch?v=${youtube}&t=${start}s`}>Watch on YouTube</a>
    </span>
  </figcaption>
</figure>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('.clip .frame')) {
    button.addEventListener('click', () => {
      const player = document.createElement('iframe');
      player.src = button.dataset.src!;
      player.title = button.dataset.title!;
      player.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      player.allowFullscreen = true;
      player.className = 'frame';
      button.replaceWith(player);
      player.focus();
    });
  }
</script>

<style>
  .clip {
    margin: 0;
  }
  .frame {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    padding: 0;
    border: 0;
    border-radius: 6px;
    overflow: hidden;
    background: var(--turf-deep);
    cursor: pointer;
  }
  :global(iframe.frame) {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
    border-radius: 6px;
  }
  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .play {
    position: absolute;
    left: 50%;
    top: 50%;
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    margin: -32px 0 0 -32px;
    border-radius: 50%;
    background: rgb(6 10 15 / 0.82);
    color: var(--line);
  }
  .frame:hover .play {
    background: var(--turf);
  }
  .from {
    position: absolute;
    left: 10px;
    bottom: 10px;
    padding: 4px 8px 3px;
    border-radius: 2px;
    background: rgb(6 10 15 / 0.82);
    color: var(--line);
    font: 700 14px/1 var(--display);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  figcaption {
    display: grid;
    gap: 2px;
    margin-top: 8px;
    font-size: 16px;
    line-height: 1.4;
  }
  figcaption strong {
    font-weight: 600;
  }
  figcaption span {
    color: var(--ink-soft);
    font-size: 15px;
  }
</style>
