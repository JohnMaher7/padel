---
// Our half of the court, from above, with each situation pinned where it
// happens. It's a picture of the list beside it, so screen readers skip it and
// read the list instead.
import type { Topic } from '../lib/topics';

interface Props {
  topics: Topic[];
}
const { topics } = Astro.props;
const pins = topics.flatMap((t) => (t.entry.data.spot ? [{ topic: t, x: t.entry.data.spot[0], y: t.entry.data.spot[1] }] : []));

// SVG units: 10 per metre; the net is at y 0 and our back glass at y 100.
// A strip of their half shows above the net, so the net reads as a net.
const P = 5; // room around the court for the walls
const FAR = 14; // how much of their half shows
const Y = (m: number) => (m - 10) * 10;
const service = Y(16.95);
---

<figure class="map">
  <div class="court" aria-hidden="true">
    <svg viewBox={`${-P} ${-FAR} ${100 + 2 * P} ${100 + FAR + P}`}>
      <defs>
        <pattern id="map-mesh" width="1.5" height="1.5" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
          <rect width="1.5" height="1.5" fill="#0e1c2b"></rect>
          <path d="M0 0V1.5M0 0H1.5" stroke="#7d93a8" stroke-width="0.22" fill="none"></path>
        </pattern>
      </defs>
      <rect x={-P} y={-FAR} width={100 + 2 * P} height={100 + FAR + P} fill="#13243a"></rect>
      {[-1, 0, 1, 2, 3, 4].map((i) => <rect x="0" y={i * 20} width="100" height="20" fill={i % 2 ? '#2663a4' : '#2a6aae'} />)}
      <path d={`M0 ${service}H100M50 ${-FAR}V${service}`} stroke="#f4f7fa" stroke-width="0.6" fill="none" opacity="0.92"></path>
      <!-- Mesh along the sides nearer the net, glass for the last 4 m and across the back. -->
      <rect x="-1.6" y={-FAR} width="1.6" height={60 + FAR} fill="url(#map-mesh)"></rect>
      <rect x="100" y={-FAR} width="1.6" height={60 + FAR} fill="url(#map-mesh)"></rect>
      <g fill="#bfe9ff" fill-opacity="0.34" stroke="#e8f8ff" stroke-width="0.35">
        <rect x="-2.4" y="60" width="2.4" height="40"></rect>
        <rect x="100" y="60" width="2.4" height="40"></rect>
        <rect x="-2.4" y="100" width="104.8" height="2.4"></rect>
      </g>
      <!-- Their half, dimmed: the map is about our side. -->
      <rect x="0" y={-FAR} width="100" height={FAR} fill="#0b1726" opacity="0.45"></rect>
      <rect x="0" y="0.6" width="100" height="2.2" fill="#000" opacity="0.16"></rect>
      <rect x="-1" y="-0.7" width="102" height="1.4" fill="#1b2633"></rect>
      <line x1="-1" y1="-0.65" x2="101" y2="-0.65" stroke="#ffffff" stroke-width="0.5"></line>
      <rect x="-2.6" y="-1.4" width="2" height="2.8" rx="0.4" fill="#0a1420" stroke="#546577" stroke-width="0.3"></rect>
      <rect x="100.6" y="-1.4" width="2" height="2.8" rx="0.4" fill="#0a1420" stroke="#546577" stroke-width="0.3"></rect>
    </svg>
    {
      pins.map(({ topic, x, y }) => (
        <a
          class:list={['pin', { left: x > 6 }]}
          href={topic.url}
          tabindex="-1"
          style={`left: ${((x * 10 + P) / (100 + 2 * P)) * 100}%; top: ${((Y(y) + FAR) / (100 + FAR + P)) * 100}%`}
        >
          <span class="ball" />
          <span class="label">{topic.entry.data.title}</span>
        </a>
      ))
    }
  </div>
  <figcaption>Your half of the court. Each situation sits where it starts.</figcaption>
</figure>

<style>
  .map {
    margin: 0;
  }
  .court {
    position: relative;
    aspect-ratio: 110 / 119;
    border-radius: 6px;
    overflow: hidden;
    box-shadow: 0 0 0 1px #223244, 0 12px 32px rgb(16 35 56 / 0.25);
  }
  svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  .pin {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 8px;
    transform: translate(-9px, -50%);
    text-decoration: none;
    color: #102338;
  }
  .pin.left {
    flex-direction: row-reverse;
    transform: translate(calc(-100% + 9px), -50%);
  }
  /* The ball, with its shadow down and to the right, as on the animated court. */
  .ball {
    flex: none;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: #e4f23a;
    border: 1.5px solid #5f6b00;
    box-shadow: 4px 3px 0 rgb(0 0 0 / 0.28);
  }
  .label {
    padding: 6px 10px 5px;
    background: #f4f7fa;
    border-radius: 2px;
    font: 700 19px/1 var(--display);
    white-space: nowrap;
    box-shadow: 0 2px 6px rgb(0 0 0 / 0.25);
  }
  .pin:hover .label {
    background: #ffffff;
    box-shadow: 0 0 0 2px var(--kit), 0 2px 6px rgb(0 0 0 / 0.25);
  }
  figcaption {
    margin-top: 10px;
    font-size: 15px;
    color: var(--ink-soft);
  }
</style>
